+std::shared_ptr<LinuxReceiver> LinuxReceiverOp::make_receiver(
+    CUdeviceptr buffer, size_t buffer_size, size_t page_size, unsigned pages,
+    int socket, uint64_t received_offset, unsigned queue_size)
+{
+    if (this->params().receiver_factory) {
+        return this->params().receiver_factory(buffer, buffer_size, page_size, pages,
+            socket, received_offset, queue_size);
+    }
+    return std::make_shared<LinuxReceiver>(buffer, buffer_size, page_size, pages,
+        socket, received_offset, queue_size);
+}
